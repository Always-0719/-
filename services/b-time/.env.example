# B 线服务配置（复制为 .env 使用；.env 不入 git）
B_PORT=8788
B_DB_PATH=./data/b-time.sqlite

# 依赖切换（mock 先行；接真改 false 并配 *_REAL_URL）
USE_MOCK_A=true
A_BASE_URL=http://127.0.0.1:8787
A_REAL_URL=
USE_MOCK_C=true
C_BASE_URL=http://127.0.0.1:8787
C_REAL_URL=

# writeEvent 本地兜底队列（断网补传）
B_EVENT_QUEUE_PATH=./data/event-queue.jsonl

# 会话：mock = 兼容 e2e mock 的 tok-* 解析（仅开发）；jwt = 接 A 真实校验（第 4 周）
SESSION_MODE=mock

# AI：mock = 离线确定性拆解；openai = OpenAI 兼容接口（需配 AI_API_KEY/AI_API_URL）
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
# 成本上限：以 groupId+日 记账（draft 阶段尚无 assignment）；超限降级推荐模板
AI_MAX_CALLS_PER_ASSIGNMENT=3
AI_DAILY_TOKEN_BUDGET=20000

# 邮件：留空则 dev outbox 落文件（data/outbox/）
SMTP_URL=

# 微信订阅消息（R3 结论出来前默认关闭）
WECHAT_ENABLED=false