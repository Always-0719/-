# B 线服务配置（复制为 .env 使用；.env 不入 git）
B_PORT=8788
B_DB_PATH=./data/b-time.sqlite

# 依赖切换（mock 先行，接真改 false + 对应 BASE_URL）
USE_MOCK_A=true
A_BASE_URL=http://127.0.0.1:8787
USE_MOCK_C=true
C_BASE_URL=http://127.0.0.1:8787

# 会话：mock = 兼容 e2e mock 的 tok-* 解析（仅开发）；jwt = 接 A 真实校验（第 4 周）
SESSION_MODE=mock

# AI：mock = 离线确定性拆解；真实 provider 需配密钥
AI_PROVIDER=mock
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_CALLS_PER_ASSIGNMENT=3

# 邮件：留空则 dev outbox 落文件（data/outbox/）
SMTP_URL=

# 微信订阅消息（R3 结论出来前默认关闭）
WECHAT_ENABLED=false